+}
+static const unsigned ref_pal[16] = {
+  0x000000, 0x0000c0, 0xc00000, 0xc000c0, 0x00c000, 0x00c0c0, 0xc0c000, 0xc0c0c0,
+  0x000000, 0x0000ff, 0xff0000, 0xff00ff, 0x00ff00, 0x00ffff, 0xffff00, 0xffffff };
+static int
+ref_key( const char *n )
+{
+  if( !strcmp( n, "space" ) ) return KEYBOARD_space;
+  if( !strcmp( n, "enter" ) ) return KEYBOARD_Enter;
+  if( strlen( n ) == 1 && n[0] >= 'a' && n[0] <= 'z' ) return KEYBOARD_a + ( n[0] - 'a' );
+  if( strlen( n ) == 1 && n[0] >= '0' && n[0] <= '9' ) return KEYBOARD_0 + ( n[0] - '0' );
+  return -1;
+}
+void
