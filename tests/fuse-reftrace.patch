+  if( !ref_out ) ref_out = fopen( getenv( "REFOUT" ) ? getenv( "REFOUT" ) : "ref.trace", "w" );
+  ref_frame++;
+  for( a = 0x4000; a < 0x10000; a++ ) rh = fnv( rh, readbyte_internal( a ) );
+  for( y = 8; y < 232; y++ ) for( x = 16; x < 304; x++ ) {
+    unsigned c = ref_pal[ ref_screen[ y ][ x ] ];
